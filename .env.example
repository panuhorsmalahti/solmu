# Fill this key to enable OpenAI replies.
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Optional: choose a model instead of genai's first listed model.
# LLM_MODEL=gpt-6-sol

# Optional cheaper model for titles and conversation summaries.
# Defaults to GPT-6 Luna or Claude Haiku when available; otherwise uses the main model.
# LLM_CHEAP_MODEL=gpt-6-luna
# LLM_TITLE_MODEL remains supported as an older alias.

# Optional token-window override for automatic compaction.
# LLM_CONTEXT_WINDOW=1000000

# Optional: override the provider's native API base URL (include its API path).
# LLM_ENDPOINT=https://your-provider.example/v1/

# Optional local settings. Docker supplies its own bind address and database path.
# SOLMU_WEB_DIR=/absolute/path/to/web-client
# SOLMU_BIND_ADDR=127.0.0.1:3000
# SOLMU_WEBHOOK_BIND_ADDR=127.0.0.1:3001
# SOLMU_DATABASE_URL=sqlite://solmu.db
# SOLMU_BACKEND_URL=http://127.0.0.1:3000
# SOLMU_WORKSPACE=/absolute/path/to/workspace
# SOLMU_MUXER_DIR=/absolute/path/to/private/muxer-state
# SOLMU_MUXER_CONFIG=/absolute/path/to/muxer-config.toml
